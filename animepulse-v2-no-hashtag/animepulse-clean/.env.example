# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Firebase service account JSON (stringified, one line) — for server-side API routes
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"YOUR_PROJECT","private_key":"...","client_email":"..."}

# Firebase client-side SDK (for client-side features, e.g. realtime)
# Get these from Firebase Console → Project Settings → Your Apps
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# ─── AI PROVIDERS (at least one required for AutoPilot) ──────────────────────
# Groq (primary - fast and free tier generous)
# Get key at: https://console.groq.com
GROQ_API_KEY=gsk_...

# Google Gemini (fallback)
# Get key at: https://makersuite.google.com
GEMINI_API_KEY=AIza...

# ─── ADMIN SECURITY ──────────────────────────────────────────────────────────
# Password for /admin dashboard (change this!)
ADMIN_PASSWORD=your-secure-admin-password-here

# ─── Affiliate Program IDs (optional — adds monetization) ─────────────────────
# Amazon Associates tag (format: yoursite-20)
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=animepulse-20
# Crunchyroll Affiliate Program ID
NEXT_PUBLIC_CRUNCHYROLL_AFFILIATE_ID=

# Secret for triggering AutoPilot via cron job
CRON_SECRET=your-cron-secret-here

# ─── APP CONFIG ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://animepulse.online

# ─── MONETIZATION (optional) ─────────────────────────────────────────────────
# Google AdSense publisher ID (when approved)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXXX

# ─── SEO ─────────────────────────────────────────────────────────────────────
# Google Search Console verification code
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── DISCORD (optional - for auto-publishing to server) ──────────────────────
# Create a webhook in your Discord server: Server Settings → Integrations → Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ─── CONTACT ─────────────────────────────────────────────────────────────────
# Public contact email shown on the contact page
NEXT_PUBLIC_CONTACT_EMAIL=contact@animepulse.online
